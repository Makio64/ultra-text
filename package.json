{
  "name": "ultra-text",
  "version": "1.0.0",
  "description": "DOM to WebGPU/TSL: real HTML, laid out by the browser, rendered as live 3D text (Three.js, R3F, TresJS, Mini3, and vanilla JS).",
  "keywords": [
    "three",
    "three.js",
    "threejs",
    "webgpu",
    "tsl",
    "text",
    "3d-text",
    "text-rendering",
    "typography",
    "sdf",
    "signed-distance-field",
    "font",
    "dom",
    "html",
    "react-three-fiber",
    "r3f",
    "tresjs",
    "mini3",
    "emoji",
    "svg",
    "vanilla"
  ],
  "homepage": "https://ultra-text.makio.io/docs",
  "bugs": {
    "url": "https://github.com/Makio64/ultra-text/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Makio64/ultra-text.git"
  },
  "license": "MIT",
  "author": {
    "name": "David Ronai",
    "url": "https://makio.io"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "licenses/WINDFOIL-APACHE-2.0.txt",
    "licenses/GLYPH-MIT.txt",
    "licenses/SLUG-MIT.txt"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vanilla": {
      "types": "./dist/vanilla.d.ts",
      "import": "./dist/vanilla.js"
    },
    "./package.json": "./package.json"
  },
  "packageManager": "pnpm@12.3.4",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "pnpm run build:lib && pnpm run build:types",
    "build:lib": "vite build",
    "build:types": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "size": "size-limit",
    "publint": "publint",
    "attw": "attw --pack . --profile esm-only",
    "pack:check": "pnpm pack --dry-run",
    "package:check": "pnpm run build && pnpm run size && pnpm run publint && pnpm run attw && pnpm run pack:check",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test:coverage && pnpm run build && pnpm run size && pnpm run publint && pnpm run attw && pnpm run pack:check",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run check"
  },
  "dependencies": {
    "@chenglou/pretext": "^1.0.0"
  },
  "peerDependencies": {
    "three": ">=0.187.0 <0.188.0"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@size-limit/preset-small-lib": "^13.0.3",
    "@types/node": "^26.4.1",
    "@types/three": "^0.187.0",
    "@typescript/native": "npm:typescript@~7.0.2",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "publint": "^0.3.24",
    "size-limit": "^13.0.3",
    "three": "0.187.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.4",
    "vitest": "^5.0.0"
  },
  "size-limit": [
    {
      "name": "public entry",
      "path": "dist/index.js",
      "limit": "35 kB",
      "ignore": [
        "three",
        "@chenglou/pretext",
        "./dist/atlas/cpuAtlas.js",
        "./dist/dom/browserShaping.js",
        "./dist/dom/pretextLayout.js",
        "./dist/windfoil/runtime.js",
        "./dist/slug/runtime.js",
        "./dist/atlas/colorGlyphs.js",
        "./dist/windfoil/shapes.js",
        "./dist/windfoil/svg/convert.js",
        "./dist/dom/svgCapture.js",
        "./dist/atlas/shapeRaster.js",
        "./dist/windfoil/color.js",
        "./dist/windfoil/emoji.js",
        "./dist/windfoil/mixed.js",
        "./dist/windfoil/svg/pathConverter.js",
        "./dist/windfoil/requests.js",
        "./dist/windfoil/layerNormalization.js",
        "./dist/windfoil/emojiMetrics.js",
        "./dist/windfoil/sizeSwitch.js",
        "./dist/atlas/appendAtlas.js",
        "./dist/windfoil/tracedOutlines.js"
      ]
    },
    {
      "name": "vanilla entry (Three-free)",
      "path": "dist/vanilla.js",
      "limit": "28.5 kB",
      "ignore": [
        "@chenglou/pretext",
        "./dist/dom/browserShaping.js",
        "./dist/dom/pretextLayout.js",
        "./dist/atlas/colorGlyphs.js",
        "./dist/windfoil/svg/convert.js",
        "./dist/dom/svgCapture.js",
        "./dist/atlas/shapeRaster.js",
        "./dist/windfoil/svg/pathConverter.js"
      ]
    },
    {
      "name": "optional Pretext layout",
      "path": "dist/dom/pretextLayout.js",
      "limit": "2.7 kB",
      "ignore": [
        "@chenglou/pretext",
        "./dist/dom/clusters.js",
        "./dist/dom/textTransform.js"
      ]
    },
    {
      "name": "optional browser shaping",
      "path": "dist/dom/browserShaping.js",
      "limit": "4.5 kB"
    },
    {
      "name": "optional Windfoil backend",
      "path": "dist/windfoil/runtime.js",
      "limit": "16 kB",
      "ignore": [
        "three",
        "@chenglou/pretext",
        "./dist/windfoil/svg/convert.js",
        "./dist/windfoil/color.js",
        "./dist/windfoil/requests.js",
        "./dist/windfoil/layerNormalization.js",
        "./dist/windfoil/emojiMetrics.js",
        "./dist/windfoil/sizeSwitch.js"
      ]
    },
    {
      "name": "optional Slug backend",
      "path": "dist/slug/runtime.js",
      "limit": "16 kB",
      "ignore": [
        "three",
        "@chenglou/pretext",
        "./dist/windfoil/svg/convert.js",
        "./dist/windfoil/color.js",
        "./dist/windfoil/requests.js",
        "./dist/windfoil/layerNormalization.js",
        "./dist/windfoil/emojiMetrics.js",
        "./dist/windfoil/sizeSwitch.js"
      ]
    },
    {
      "name": "optional CPU fallback",
      "path": "dist/atlas/cpuAtlas.js",
      "limit": "3 kB",
      "ignore": [
        "three"
      ]
    },
    {
      "name": "CPU worker asset",
      "path": "dist/assets/cpuSdf.worker-*.js",
      "limit": "2.5 kB"
    },
    {
      "name": "optional colour glyphs",
      "path": "dist/atlas/colorGlyphs.js",
      "limit": "2.5 kB",
      "ignore": [
        "three"
      ]
    },
    {
      "name": "optional Windfoil shapes",
      "path": "dist/windfoil/shapes.js",
      "limit": "17.5 kB",
      "ignore": [
        "three",
        "@chenglou/pretext",
        "./dist/windfoil/color.js"
      ]
    },
    {
      "name": "complete SVG converter",
      "path": "dist/windfoil/svg/convert.js",
      "limit": "14.5 kB",
      "ignore": [
        "three"
      ]
    },
    {
      "name": "optional SVG capture",
      "path": "dist/dom/svgCapture.js",
      "limit": "8.5 kB",
      "ignore": []
    },
    {
      "name": "optional SVG raster",
      "path": "dist/atlas/shapeRaster.js",
      "limit": "2.5 kB",
      "ignore": []
    },
    {
      "name": "optional Windfoil colour",
      "path": "dist/windfoil/color.js",
      "limit": "12.5 kB",
      "ignore": [
        "three",
        "@chenglou/pretext",
        "./dist/text/GlyphTextMaterial.js",
        "./dist/text/geometryUtils.js",
        "./dist/windfoil/coverage.js"
      ]
    },
    {
      "name": "optional SVG emoji provider",
      "path": "dist/windfoil/emoji.js",
      "limit": "2 kB",
      "ignore": [
        "./dist/windfoil/svg/convert.js",
        "./dist/windfoil/emojiMetrics.js"
      ]
    },
    {
      "name": "optional mixed text parts",
      "path": "dist/windfoil/mixed.js",
      "limit": "4 kB",
      "ignore": [
        "three",
        "./dist/text/geometry.js",
        "./dist/text/SdfTextMaterial.js",
        "./dist/text/decorations.js",
        "./dist/text/geometryUtils.js"
      ]
    },
    {
      "name": "optional Windfoil size switch",
      "path": "dist/windfoil/sizeSwitch.js",
      "limit": "2 kB",
      "ignore": [
        "three",
        "./dist/dom/clusters.js",
        "./dist/windfoil/geometry.js",
        "./dist/text/geometryUtils.js",
        "./dist/text/decorations.js"
      ]
    },
    {
      "name": "DOM-free SVG path converter",
      "path": "dist/windfoil/svg/pathConverter.js",
      "limit": "9 kB",
      "ignore": [
        "three"
      ]
    },
    {
      "name": "SVG document adapter increment",
      "path": "dist/windfoil/svg/convert.js",
      "limit": "8.5 kB",
      "ignore": [
        "three",
        "./dist/windfoil/svg/pathConverter.js"
      ]
    },
    {
      "name": "optional Windfoil request handling",
      "path": "dist/windfoil/requests.js",
      "limit": "2.5 kB",
      "ignore": [
        "three",
        "./dist/windfoil/svg/convert.js",
        "./dist/windfoil/svg/pathConverter.js",
        "./dist/windfoil/storage.js"
      ]
    },
    {
      "name": "optional Windfoil layer validation",
      "path": "dist/windfoil/layerNormalization.js",
      "limit": "2.5 kB",
      "ignore": [
        "./dist/windfoil/preprocessCore.js"
      ]
    },
    {
      "name": "optional SVG emoji metrics",
      "path": "dist/windfoil/emojiMetrics.js",
      "limit": "2 kB",
      "ignore": [
        "./dist/windfoil/svg/convert.js",
        "./dist/windfoil/svg/pathConverter.js",
        "./dist/windfoil/storage.js"
      ]
    },
    {
      "name": "optional atlas append",
      "path": "dist/atlas/appendAtlas.js",
      "limit": "4 kB",
      "ignore": [
        "three",
        "./dist/atlas/rasterize.js",
        "./dist/atlas/gpuAtlas.js",
        "./dist/atlas/colorGlyphs.js",
        "./dist/dom/browserShaping.js"
      ]
    },
    {
      "name": "optional traced outlines",
      "path": "dist/windfoil/tracedOutlines.js",
      "limit": "7 kB",
      "ignore": [
        "three",
        "./dist/atlas/rasterize.js",
        "./dist/atlas/colorGlyphs.js"
      ]
    }
  ]
}
